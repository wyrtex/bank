# ===== секреты бэкенда =====  (скопируй в backend/.env и заполни; .env в git НЕ попадает)

# ключ TronGrid (trongrid.io -> API Keys)
TRON_API_KEY=

# горячий кошелёк: адрес и приватный ключ (экспорт из TronLink). Приватный ключ — только здесь!
WALLET_ADDRESS=T...
WALLET_PRIVATE_KEY=

# ключ доступа приложения (придумай длинную строку; её вводишь в приложении при входе)
ACCESS_KEY=

# кому вообще можно платить (адреса через запятую) — белый список
ALLOWLIST=

# лимиты безопасности
PER_TX_LIMIT=50
DAILY_LIMIT=300
RESERVE_TRX=20

# 0 — сухой прогон (ничего не отправляем, только считаем). 1 — реальные переводы (после теста!)
WALLET_LIVE=0
